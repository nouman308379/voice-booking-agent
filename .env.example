# ─── Business ────────────────────────────────────────────────────────────────
BUSINESS_NAME="Riverside Dental"
BUSINESS_TIMEZONE="America/Toronto"

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Signs slot_id tokens. Changing this invalidates outstanding slot_ids
# (they fail closed, which is correct).
SLOT_ID_HMAC_SECRET="<openssl rand -hex 32>"
# Shared secret ElevenLabs sends on every tool call.
VOICE_TOOL_SECRET="<openssl rand -hex 32>"

# ─── ElevenLabs (Phase 3+) ───────────────────────────────────────────────────
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_WEBHOOK_SECRET=""

# ─── Public base URL for webhook registration (ngrok/cloudflared in dev) ─────
PUBLIC_BASE_URL="http://localhost:3000"
